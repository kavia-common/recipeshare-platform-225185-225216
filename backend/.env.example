# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# App URLs
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=please-set-a-strong-random-secret
SITE_URL=http://localhost:3000

# Database (Supabase Postgres connection string)
# Format tip: postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL=postgres://postgres:postgres@db.supabase.co:5432/postgres?sslmode=require

# Supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# Cloudinary (kept as primary storage unless changed)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=flavorfolio

# Optional debug
DEBUG_STARTUP=false
REACT_APP_HEALTHCHECK_PATH=/health
