# Backend environment example for FlavorFolio Express API

# Server
REACT_APP_PORT=3001
REACT_APP_HEALTHCHECK_PATH=/health
HOST=0.0.0.0
NODE_ENV=development

# Auth
NEXTAUTH_SECRET=replace-with-strong-secret
NEXTAUTH_URL=http://localhost:3001

# Database (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# Cloudinary (optional in development; required for image upload endpoints)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=flavorfolio

# Cross-container URLs (if used by frontend)
REACT_APP_API_BASE=http://localhost:3001
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=

# Feature flags and misc
REACT_APP_NODE_ENV=development
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# Supabase (if applicable for client signup redirect usage)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=
